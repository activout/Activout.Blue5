<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>blue5</ToolCommandName>
    <AssemblyName>blue5</AssemblyName>
    <RootNamespace>Activout.Blue5.Cli</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Activout.Blue5.Cli</PackageId>
    <Title>Activout.Blue5.Cli</Title>
    <Description>blue5: command-line tool for inspecting and exporting Bluestone PIM products via the Public API.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/activout/Activout.Blue5</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>bluestone;pim;papi;cli;export;ndjson</PackageTags>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Activout.Blue5/Activout.Blue5.csproj" />
    <ProjectReference Include="../Activout.Blue5.Resilience/Activout.Blue5.Resilience.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Activout.Blue5.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
